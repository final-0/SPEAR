{
    "name": "clean-step4-spring",
    "dataset": "spring",
    "feature_encoder": "dav2",
    "dav2_backbone": "vitl",
    "iterative_module": "vits",
    "algorithm": "waft-a2",
    "var_min": 0,
    "var_max": 10,
    "iters": 5,
    "image_size": [
        1080,
        1920
    ],
    "scale": 0,
    "batch_size": 8,
    "epsilon": 1e-08,
    "lr": 5e-05,
    "wdecay": 1e-05,
    "clip": 1.0,
    "gamma": 0.85,
    "num_steps": 20000,
    "restore_ckpt": "checkpoints/clean-step3-flyingthings/waft-a2/dav2/42/100000.pth",
    "use_bf16": true,
    "checkpoint_freq": 5000,
    "spring_include_val": true,
    "refine_freeze": false
}
