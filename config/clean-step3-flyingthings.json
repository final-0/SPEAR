{
    "name": "clean-step3-flyingthings",
    "dataset": "things",
    "feature_encoder": "dav2",
    "dav2_backbone": "vitl",
    "iterative_module": "vits",
    "algorithm": "waft-a2",
    "var_min": 0,
    "var_max": 10,
    "iters": 5,
    "image_size": [
        400,
        720
    ],
    "scale": -0.4,
    "batch_size": 16,
    "epsilon": 1e-08,
    "lr": 0.0001,
    "wdecay": 1e-05,
    "clip": 1.0,
    "gamma": 0.85,
    "num_steps": 200000,
    "restore_ckpt": "checkpoints/clean-step2-tartanair/waft-a2/dav2/42/200000.pth",
    "use_bf16": true,
    "checkpoint_freq": 100000,
    "refine_freeze": true
}
